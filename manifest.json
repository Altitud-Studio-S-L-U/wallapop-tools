{
  "manifest_version": 3,
  "name": "Wallapop Tools - Automatiza tus ventas",
  "version": "1.0.0",
  "description": "Republica, gestiona precios y automatiza tu Wallapop. Vende más con menos esfuerzo.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.wallapop.com/*",
    "https://es.wallapop.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://es.wallapop.com/*"
      ],
      "js": [
        "utils/wallapop-api.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
